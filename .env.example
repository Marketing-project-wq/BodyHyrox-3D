# === REQUIRED (set this one in Railway → Variables) ===
# Supabase service role key (server-only secret). Get it from Supabase →
# Project Settings → API → service_role → Reveal.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === OPTIONAL ===
# Project URL is hardcoded to the known project by default; override only if needed.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Session cookie signing secret. If omitted, it is derived from the service role
# key automatically, so you normally do not need to set this.
# SESSION_SECRET=any-random-string
